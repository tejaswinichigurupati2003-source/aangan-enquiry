{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/webhooks/vaani/:secret",
      "destination": "/api/vaani-webhook?secret=:secret"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "{config.yaml,prompts/*.md,src/dashboard/page.html}",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
