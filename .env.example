# Copy to .env — NEVER commit .env. Secrets live here and nowhere else.

# --- LLM (Gemini) ---
GEMINI_API_KEY=
# aistudio (keys starting AIza...) | vertex (Vertex AI express-mode keys starting AQ....)
GEMINI_BACKEND=aistudio

# --- Master live switch. Everything is DRY-RUN unless this is 1 AND the relevant creds exist. ---
AANGAN_LIVE=0

# --- Telegram (designer handoff + paging Nikhil) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_NIKHIL_CHAT_ID=

# --- HubSpot (private app token; Green LIVE leads only) ---
HUBSPOT_TOKEN=

# --- Email backup log (Resend-style HTTP API) ---
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# --- Telephony (stub only; no live number is wired) ---
TELEPHONY_PROVIDER=stub
TELEPHONY_API_KEY=

# --- Vani (vaanivoice.ai) ---
VAANI_API_KEY=                 # Vani dashboard → API keys (format vaani_...). Used to VERIFY webhooks and to place call-backs.
VAANI_AGENT_ID=                # Vani dashboard → Agent Config → agent UUID (for call-backs)
VAANI_WEBHOOK_SECRET=          # YOU invent this: a long random string. It goes in the webhook URL path. (openssl rand -hex 24)
VAANI_BYOL_TOKEN=              # YOU invent this: a long random string. Paste the same value into the BYOL "Auth Token" box in Vani.

# --- Supabase ---
STORAGE_BACKEND=json           # json (local file) | supabase
SUPABASE_URL=                  # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # Project Settings → API → service_role. SERVER ONLY. Never in a browser, never in git.

# --- Server ---
PORT=8787

# Optional: with DASHBOARD_AUTH=off, require this PIN for any change made from the dashboard (reassign, book, notes). Reading stays open.
DASHBOARD_TEAM_PIN=

# Optional: put consultations straight onto the studio's Google Calendar (service account; see src/integrations/gcal.js header)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Secret in the URL of the studio calendar feed (/api/calendar?token=...). Subscribe to it from Google Calendar (Other calendars -> From URL). Empty = feed off.
CALENDAR_FEED_TOKEN=

# Private iCal address of the studio Google Calendar (read-only; the AI will not offer times that are already busy)
CALENDAR_ICAL_URL=
